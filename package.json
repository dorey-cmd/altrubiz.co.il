{
  "name": "altrubiz-replica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "og:generate": "node scripts/generate-og-images.cjs",
    "articles:sync-md": "node scripts/sync-articles-md.cjs",
    "llms:generate": "node scripts/generate-llms-txt.cjs",
    "sitemap:generate": "node scripts/generate-sitemap.cjs",
    "test:geo": "node scripts/validate-geo.cjs",
    "test:machine": "node scripts/validate-machine-knowledge-surface.cjs",
    "test:render": "node scripts/validate-route-render.cjs",
    "test:scroll": "node scripts/validate-scroll-sovereignty.cjs",
    "test:semantic": "node scripts/validate-runtime-semantic-links.cjs",
    "test:conversion": "node scripts/validate-conversion-context.cjs",
    "test:article-ready": "node scripts/validate-article-ready.cjs",
    "test:review-cockpit": "node scripts/validate-review-cockpit.cjs",
    "test:distribution": "node scripts/validate-distribution-foundation.cjs",
    "test:url-migration": "node scripts/validate-url-migration.cjs",
    "release:gate": "node scripts/release-gate.cjs",
    "geo:audit": "node scripts/validate-geo.cjs",
    "test": "npm run test:article-ready && npm run test:review-cockpit && npm run test:distribution && npm run test:geo && npm run test:machine && npm run test:render && npm run test:conversion && npm run test:scroll && npm run test:semantic",
    "prebuild": "node scripts/generate-og-images.cjs && npm run articles:sync-md && npm run llms:generate && npm run sitemap:generate && npm run test:geo && npm run test:machine",
    "build": "npm run prebuild && tsc -b && vite build && node scripts/prerender-pages.cjs && npm run test:render",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.30.0",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
